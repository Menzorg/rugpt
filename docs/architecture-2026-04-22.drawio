        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2f_title" value="&lt;b&gt;Dev endpoints — F. Dev-VPS, Macbook, G. Alexander PC&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="p2f_f" value="&lt;b&gt;F. Dev-VPS&lt;/b&gt; — Ubuntu · отдельный публичный IP&lt;br&gt;&lt;br&gt;/root/rugpt/ · /root/webclient_rugpt/&lt;br&gt;&lt;b&gt;Без&lt;/b&gt; .git · .env · venv · node_modules&lt;br&gt;&lt;br&gt;Цель: минимизация blast-radius&lt;br&gt;компрометация = только код snapshot,&lt;br&gt;без истории и секретов&lt;br&gt;&lt;br&gt;Скрипты: sync.sh (F → macbook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="p2f_mac" value="&lt;b&gt;Macbook (Petr — lead dev)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Полный репозиторий с .git&lt;br&gt;SSH-keys → Prod VPS, RAG, Dev-VPS&lt;br&gt;&lt;br&gt;Скрипты:&lt;br&gt;  sync.sh (← F)&lt;br&gt;  deploy.sh (→ Prod, → RAG)&lt;br&gt;&lt;br&gt;&lt;b&gt;Единая точка доступа к prod:&lt;/b&gt;&lt;br&gt;компрометация = total access&lt;br&gt;(HW key рекомендуется)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="p2f_g" value="&lt;b&gt;G. Alexander PC&lt;/b&gt; — второй разработчик&lt;br&gt;&lt;br&gt;Свой компьютер&lt;br&gt;Push в feature/* , dev&lt;br&gt;→ GitHub / GitLab (после миграции)&lt;br&gt;&lt;br&gt;SSH-keys&lt;br&gt;VPN к офису (опц.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="p2f_prod" value="&lt;b&gt;Prod VPS (A)&lt;/b&gt;&lt;br&gt;deploy target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="500" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="p2f_ragt" value="&lt;b&gt;RAG rugpt-container&lt;/b&gt;&lt;br&gt;deploy target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="500" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="p2f_gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;(миграция → GitLab)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="p2f_gl" value="&lt;b&gt;GitLab CE (B.I.2)&lt;/b&gt;&lt;br&gt;SSH NAT :28351&lt;br&gt;(план после миграции)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p2f_e1" value="sync.sh&#10;SSH rsync" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p2f_f" target="p2f_mac"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2f_e2" value="deploy.sh" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p2f_mac" target="p2f_prod"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2f_e3" value="deploy.sh" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p2f_mac" target="p2f_ragt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2f_e4" value="git push" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p2f_mac" target="p2f_gh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2f_e5" value="git push" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p2f_g" target="p2f_gh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2f_e6" value="git push (план)" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p2f_g" target="p2f_gl"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p2g" name="2g. Periphery (Omada + NAS)">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2g_title" value="&lt;b&gt;D. Omada ER605  &amp;  E. NAS Synology&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="p2g_omada" value="&lt;b&gt;D. Omada ER605&lt;/b&gt;  (TP-Link dual-WAN gateway)&lt;br&gt;&lt;br&gt;&lt;b&gt;WAN:&lt;/b&gt; ISP #1 + ISP #2 (failover)&lt;br&gt;&lt;b&gt;Public IP:&lt;/b&gt; 217.113.118.218&lt;br&gt;&lt;br&gt;&lt;b&gt;LAN:&lt;/b&gt; 192.168.1.0/24 (DHCP)&lt;br&gt;&lt;b&gt;WireGuard сервер:&lt;/b&gt; 10.0.0.0/24&lt;br&gt;   · 10.0.0.1 — Prod-VPS&lt;br&gt;   · 10.0.0.2 — RAG&lt;br&gt;&lt;br&gt;&lt;b&gt;NAT port-forward:&lt;/b&gt;&lt;br&gt;   :28351 → 192.168.1.118:22  (GitLab SSH)&lt;br&gt;   :24952 → 192.168.1.119:22  (Runner SSH)&lt;br&gt;&lt;br&gt;&lt;b&gt;ACL:&lt;/b&gt; VPN-пир Prod-VPS → только 10.0.0.2&lt;br&gt;&lt;br&gt;&lt;b&gt;Audit concern:&lt;/b&gt; dual-WAN failover —&lt;br&gt;ACL должны быть консистентны на обоих ISP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="620" height="560" as="geometry"/></mxCell>
        <mxCell id="p2g_nas" value="&lt;b&gt;E. NAS Synology&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;OS:&lt;/b&gt; DSM 7.3.2-86009 Update 3&lt;br&gt;&lt;b&gt;IP:&lt;/b&gt; 192.168.1.38&lt;br&gt;&lt;b&gt;FS:&lt;/b&gt; Btrfs on RAID 5&lt;br&gt;&lt;br&gt;&lt;b&gt;Подключение:&lt;/b&gt; NFS к Proxmox (уточнить)&lt;br&gt;&lt;b&gt;Режим:&lt;/b&gt; WriteOnce (immutable snapshots)&lt;br&gt;&lt;br&gt;&lt;b&gt;Содержимое:&lt;/b&gt;&lt;br&gt;  · vzdump (Proxmox)&lt;br&gt;  · pg_dump (PostgreSQL)&lt;br&gt;&lt;br&gt;&lt;b&gt;Audit concern:&lt;/b&gt;&lt;br&gt;single NAS = SPOF (RAID 5 не спасает от здания/пожара)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="620" height="560" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3a" name="3a. Zero-Trust flow">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3a_title" value="&lt;b&gt;Zero-Trust  ·  JWT + ECDSA P-256 device signature&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;bearer JWT = что-украл-то-и-использовал. Подпись устройства = второй фактор, не достаётся из IndexedDB.&lt;/span&gt;" style="text;html=1;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="1200" height="60" as="geometry"/></mxCell>
        <mxCell id="p3a_c1" value="&lt;b&gt;STEP 0 — Login &amp; Device Registration&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f5e0;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="500" height="950" as="geometry"/></mxCell>
        <mxCell id="p3a_01" value="Browser:&lt;br&gt;&lt;code&gt;crypto.subtle.generateKey('ECDSA', P-256, extractable=false)&lt;/code&gt;&lt;br&gt;→ {privateKey, publicKey}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="p3a_02" value="privateKey → IndexedDB&lt;br&gt;&lt;b&gt;non-extractable&lt;/b&gt; · publicKey → PEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="p3a_03" value="&lt;b&gt;POST /api/auth/login&lt;/b&gt;&lt;br&gt;{ email, password, devicePublicKey }&lt;br&gt;Authorization: none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="p3a_04" value="NestJS  →  Engine POST /api/v1/auth/login&lt;br&gt;через WireGuard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="p3a_05" value="&lt;b&gt;Engine:&lt;/b&gt;&lt;br&gt;verify_password (bcrypt 12 rounds)&lt;br&gt;device_storage.register_device → INSERT user_devices&lt;br&gt;create_token → &lt;b&gt;JWT HMAC-SHA256&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="p3a_06" value="Browser:&lt;br&gt;token → Zustand (memory)&lt;br&gt;privateKey остаётся в IndexedDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="460" height="80" as="geometry"/></mxCell>
        <mxCell id="p3a_07" value="&lt;b&gt;Invariant:&lt;/b&gt; приватный ключ никогда не покидает браузер.&lt;br&gt;Никакие XSS/DevTools/cookies его не извлекут." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="p3a_e01" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_01" target="p3a_02"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e02" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_02" target="p3a_03"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e03" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_03" target="p3a_04"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e04" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_04" target="p3a_05"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e05" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_05" target="p3a_06"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3a_c2" value="&lt;b&gt;STEP 1 — Signed Request&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1ecf7;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="500" height="950" as="geometry"/></mxCell>
        <mxCell id="p3a_11" value="Browser apiClient.signedGet/Post:&lt;br&gt;nonce = random(16).hex()&lt;br&gt;sig_timestamp = now()&lt;br&gt;payload = canonical({path, body?, nonce, sig_timestamp, user_id})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="p3a_12" value="signature = ECDSA.sign(SHA256(payload), privateKey)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="270" width="460" height="50" as="geometry"/></mxCell>
        <mxCell id="p3a_13" value="&lt;b&gt;GET /api/users?signature=…&amp;nonce=…&amp;sig_timestamp=…&amp;user_id=…&lt;/b&gt;&lt;br&gt;Header: Authorization: Bearer &amp;lt;JWT&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="340" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="p3a_14" value="&lt;b&gt;NestJS SignatureGuard:&lt;/b&gt;&lt;br&gt;if @SkipSignature → skip&lt;br&gt;else POST engine /auth/verify-signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="430" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="p3a_15" value="&lt;b&gt;Engine verify_signature:&lt;/b&gt;&lt;br&gt;list user_devices&lt;br&gt;ECDSA.verify(sig, SHA256(payload), pubkey) per device&lt;br&gt;|now − sig_timestamp| &amp;lt; 5 min&lt;br&gt;nonce not in TTL cache&lt;br&gt;→ 200 / 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="460" height="140" as="geometry"/></mxCell>
        <mxCell id="p3a_16" value="&lt;b&gt;NestJS JwtAuthGuard&lt;/b&gt; (локальная валидация JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="700" width="460" height="50" as="geometry"/></mxCell>
        <mxCell id="p3a_17" value="Controller → Service → engineAdapter.execute()&lt;br&gt;→ HTTP к Engine с Authorization: Bearer &amp;lt;JWT&amp;gt;&lt;br&gt;Engine валидирует JWT ЕЩЁ РАЗ → обрабатывает запрос" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="770" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="p3a_e11" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_11" target="p3a_12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e12" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_12" target="p3a_13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e13" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_13" target="p3a_14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e14" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_14" target="p3a_15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e15" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_15" target="p3a_16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e16" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_16" target="p3a_17"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3a_c3" value="&lt;b&gt;STEP 2 — Attack: Stolen JWT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0ee;strokeColor=#b85450;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="500" height="950" as="geometry"/></mxCell>
        <mxCell id="p3a_21" value="Атакующий украл JWT (XSS, cookie):&lt;br&gt;GET /api/users&lt;br&gt;Auth: Bearer &amp;lt;stolen JWT&amp;gt;&lt;br&gt;&lt;i&gt;нет signature/nonce/sig_timestamp&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="p3a_22" value="&lt;b&gt;NestJS SignatureGuard: 'Missing signature data' → 401&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="270" width="460" height="50" as="geometry"/></mxCell>
        <mxCell id="p3a_23" value="&lt;b&gt;Попытка подписать без privateKey:&lt;/b&gt;&lt;br&gt;privateKey в жертвиной IndexedDB, non-extractable.&lt;br&gt;Не достаётся через DevTools, XSS, extension.&lt;br&gt;128-bit ECDSA brute-force — непрактично." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="340" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="p3a_24" value="&lt;b&gt;Доступны только @SkipSignature() endpoints:&lt;/b&gt;&lt;br&gt;/auth/login · /auth/register · /config&lt;br&gt;/health* · /notifications/telegram/webhook&lt;br&gt;&lt;b&gt;/files/upload&lt;/b&gt; (legacy!) · &lt;b&gt;/files/:id/download&lt;/b&gt; (legacy!)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="470" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="p3a_25" value="&lt;b&gt;Weak spots (attack surface):&lt;/b&gt;&lt;br&gt;• WebSocket не подписывается (JWT handshake)&lt;br&gt;• File upload/download — @SkipSignature&lt;br&gt;• Один JWT_SECRET на webclient + engine&lt;br&gt;• Нет admin revoke device endpoint&lt;br&gt;• Nonce-cache не persistent — replay-window при рестарте&lt;br&gt;• Engine compromise = видит pubkey + JWT_SECRET → TOTAL LOSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="600" width="460" height="180" as="geometry"/></mxCell>
        <mxCell id="p3a_e21" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_21" target="p3a_22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e22" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_22" target="p3a_23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e23" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_23" target="p3a_24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3a_e24" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3a_24" target="p3a_25"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3b" name="3b. Deploy now vs planned">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3b_title" value="&lt;b&gt;Deploy workflow  —  текущий   vs.   планируемый (после GitLab миграции)&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="40" as="geometry"/></mxCell>
        <mxCell id="p3b_left" value="&lt;b&gt;CURRENT&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="720" height="780" as="geometry"/></mxCell>
        <mxCell id="p3b_1" value="&lt;b&gt;F. Dev-VPS&lt;/b&gt;&lt;br&gt;code snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_2" value="&lt;b&gt;Macbook (Petr)&lt;/b&gt;&lt;br&gt;local repo with .git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="320" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_3" value="&lt;b&gt;GitHub&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_4" value="&lt;b&gt;Prod VPS (A)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="600" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_5" value="&lt;b&gt;RAG rugpt-container (B.I.1)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="600" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_6" value="&lt;b&gt;G. Alex PC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_le1" value="sync.sh&#10;SSH rsync" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p3b_1" target="p3b_2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_le2" value="git push" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p3b_2" target="p3b_3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_le3" value="git push" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p3b_6" target="p3b_3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_le4" value="deploy.sh" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p3b_2" target="p3b_4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_le5" value="deploy.sh" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;fontSize=10;" edge="1" parent="1" source="p3b_2" target="p3b_5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_ln" value="&lt;b&gt;Issues:&lt;/b&gt;&lt;br&gt;• Macbook = единая точка access к prod&lt;br&gt;• Нет CI / tests / approvals&lt;br&gt;• Нет audit trail deploy&lt;br&gt;• SSH keys на прошивке macbook = риск" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="640" height="120" as="geometry"/></mxCell>

        <mxCell id="p3b_right" value="&lt;b&gt;PLANNED (GitLab CI)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f5e0;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="760" height="780" as="geometry"/></mxCell>
        <mxCell id="p3b_r1" value="&lt;b&gt;Developers&lt;/b&gt;&lt;br&gt;F · Macbook · G Alex&lt;br&gt;git push origin dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_r2" value="&lt;b&gt;GitLab CE (B.I.2)&lt;/b&gt;&lt;br&gt;receive push&lt;br&gt;trigger pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="280" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p3b_r3" value="&lt;b&gt;GitLab Runner (B.II.3)&lt;/b&gt;&lt;br&gt;Docker executor&lt;br&gt;build / test / artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="280" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p3b_r4" value="&lt;b&gt;dev-vm (B.II.4)&lt;/b&gt;&lt;br&gt;auto-deploy on push dev&lt;br&gt;ручное тестирование" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="440" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p3b_r5" value="&lt;b&gt;MR dev → main&lt;/b&gt;&lt;br&gt;review + approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="440" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="p3b_r6" value="&lt;b&gt;CI  →  deploy prod&lt;/b&gt;&lt;br&gt;Prod-VPS (A) · RAG B.I.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="p3b_re1" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p3b_r1" target="p3b_r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_re2" value="trigger" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3b_r2" target="p3b_r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_re3" value="artifacts" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3b_r3" target="p3b_r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_re4" value="after test" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3b_r4" target="p3b_r5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_re5" value="approved" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3b_r5" target="p3b_r6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3b_rn" value="&lt;b&gt;Gains:&lt;/b&gt;&lt;br&gt;• code review + approval gate&lt;br&gt;• audit trail (pipeline, artifacts)&lt;br&gt;• SSH-keys deploy только в CI variables&lt;br&gt;• dev-vm = rehearsal среда&lt;br&gt;&lt;br&gt;&lt;b&gt;TODO:&lt;/b&gt; signed commits/artifacts, kaniko вместо dind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="720" width="680" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3c" name="3c. Kafka async agent">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3c_title" value="&lt;b&gt;Async agent via Kafka  —  chat message roundtrip (item 10)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;HTTP POST возвращается мгновенно с agent_pending=true; ответ приходит позже через WebSocket.&lt;/span&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="50" as="geometry"/></mxCell>
        <mxCell id="p3c_sync" value="&lt;b&gt;Sync path (HTTP, &amp;lt;100 ms)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f5e0;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1520" height="260" as="geometry"/></mxCell>
        <mxCell id="p3c_s1" value="Browser&lt;br&gt;POST /api/chat/:id/messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_s2" value="NestJS ChatController&lt;br&gt;→ engineAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_s3" value="Engine /chats/:id/messages&lt;br&gt;chat_service.add_message&lt;br&gt;ai_service.should_respond?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_s4" value="Если @@mention / auto:&lt;br&gt;• INSERT agent_runs(pending)&lt;br&gt;• publish &lt;b&gt;agent.requests&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_s5" value="return 200&lt;br&gt;{ok: true, agent_pending: true}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="170" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_se1" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3c_s1" target="p3c_s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_se2" value="WG" style="endArrow=classic;html=1;strokeColor=#6c8ebf;dashed=1;fontSize=10;" edge="1" parent="1" source="p3c_s2" target="p3c_s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_se3" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3c_s3" target="p3c_s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_se4" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3c_s4" target="p3c_s5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p3c_async" value="&lt;b&gt;Async path (Kafka, секунды–минуты — CPU/GPU inference)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1ecf7;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1520" height="560" as="geometry"/></mxCell>
        <mxCell id="p3c_a1" value="&lt;b&gt;Kafka topic: agent.requests&lt;/b&gt;&lt;br&gt;(docker-vm :9092)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="460" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_a2" value="&lt;b&gt;Engine KafkaConsumerLoop&lt;/b&gt;&lt;br&gt;(в том же uvicorn-процессе)&lt;br&gt;AgentRequestHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_a3" value="CAS agent_runs: pending → running&lt;br&gt;(idempotency при redelivery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_a4" value="&lt;b&gt;AgentExecutor&lt;/b&gt;&lt;br&gt;LangGraph (simple/chain/multi_agent)&lt;br&gt;tools invocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="450" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_a5" value="&lt;b&gt;LiteLLM :4000 @ Zver&lt;/b&gt;&lt;br&gt;→ vLLM gemma-4-31B-it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="580" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_a6" value="Engine: INSERT message (is_ai=true)&lt;br&gt;agent_runs → completed&lt;br&gt;publish &lt;b&gt;chat.events&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="680" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_a7" value="&lt;b&gt;Kafka topic: chat.events&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="690" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_a8" value="NestJS KafkaConsumerService&lt;br&gt;(per-instance consumer group)&lt;br&gt;SocketGateway.broadcastToChat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="p3c_a9" value="Browser&lt;br&gt;WS: chat.message_new event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="830" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="p3c_ae1" value="consume" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3c_a1" target="p3c_a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae2" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3c_a2" target="p3c_a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae3" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3c_a3" target="p3c_a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae4" value="LAN :4000" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p3c_a4" target="p3c_a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae5" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3c_a5" target="p3c_a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae6" value="publish" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3c_a6" target="p3c_a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae7" value="consume" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3c_a7" target="p3c_a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_ae8" value="WS" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3c_a8" target="p3c_a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3c_note" value="&lt;b&gt;Fallback:&lt;/b&gt; Config.KAFKA_ENABLED=false → весь Kafka код становится no-op. Inference блокирует HTTP (sync mode)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="830" width="1040" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3d" name="3d. Scheduler + Notifications">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3d_title" value="&lt;b&gt;Scheduler + Notifications flow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;polling 30s → trigger → agent → multi-channel delivery&lt;/span&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="50" as="geometry"/></mxCell>
        <mxCell id="p3d_sources" value="&lt;b&gt;Источники&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="520" as="geometry"/></mxCell>
        <mxCell id="p3d_src1" value="calendar_events&lt;br&gt;one_time / recurring (croniter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="p3d_src2" value="task_polls (утренние)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="p3d_src3" value="task_reports (вечерние)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="p3d_src4" value="per-org timezone&lt;br&gt;ZoneInfo (organizations.timezone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="p3d_sched" value="&lt;b&gt;SchedulerService&lt;/b&gt;&lt;br&gt;asyncio.create_task&lt;br&gt;poll 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="280" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="p3d_ai" value="&lt;b&gt;ai_service.run_proactive&lt;/b&gt;&lt;br&gt;AgentExecutor → LangGraph → LiteLLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="p3d_notif" value="&lt;b&gt;NotificationService&lt;/b&gt;&lt;br&gt;orchestrate(user, payload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="280" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="p3d_iter" value="iterate notification_channels&lt;br&gt;ORDER BY priority DESC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="440" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="p3d_tg" value="telegram_sender&lt;br&gt;api.telegram.org HTTPS&lt;br&gt;bot token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="540" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p3d_em" value="email_sender&lt;br&gt;aiosmtplib TCP/TLS&lt;br&gt;login/password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="540" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="p3d_app" value="InAppNotificationService&lt;br&gt;INSERT in_app_notifications&lt;br&gt;(колокольчик)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="440" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="p3d_log" value="notification_log (audit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="660" width="480" height="50" as="geometry"/></mxCell>
        <mxCell id="p3d_e1" value="30s query" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p3d_sources" target="p3d_sched"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e2" value="fire" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p3d_sched" target="p3d_ai"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e3" value="payload" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p3d_ai" target="p3d_notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e4" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3d_notif" target="p3d_iter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e5" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3d_iter" target="p3d_tg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e6" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3d_iter" target="p3d_em"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e7" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p3d_iter" target="p3d_app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e8" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="p3d_tg" target="p3d_log"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_e9" style="endArrow=classic;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="p3d_em" target="p3d_log"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3d_note" value="&lt;b&gt;Note:&lt;/b&gt; Telegram webhook-path (TG → Engine) &lt;b&gt;недоступен&lt;/b&gt; — engine за VPN. Исходящий вызов (Engine → api.telegram.org) работает.&lt;br&gt;PM-агент (item 10) через task_notification_service пишет в личный direct-чат юзера: публикация в chat.events → NestJS WS broadcast." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1520" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="p3e" name="3e. Threat matrix">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3e_title" value="&lt;b&gt;Threat Matrix  ·  Zero-Trust защиты&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_hT" value="&lt;b&gt;Threat&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#000000;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_hD" value="&lt;b&gt;Mitigation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#000000;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t1" value="Кража JWT (XSS, cookie)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d1" value="SignatureGuard блокирует запросы без device-signature → 401" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t2" value="Кража privateKey" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d2" value="Non-extractable ECDSA key в IndexedDB — не выносится даже через DevTools / XSS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t3" value="MITM публичный (internet users)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d3" value="TLS 1.2/1.3 на nginx (Let's Encrypt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t4" value="MITM в VPN / LAN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d4" value="WireGuard ChaCha20-Poly1305. LAN — plaintext (риск! TLS внутри отсутствует)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="240" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t5" value="Replay-атака" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d5" value="timestamp ±5 min + nonce TTL-cache (не persistent — replay-window при рестарте)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="280" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t6" value="Compromise NestJS (webclient-backend)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d6" value="NestJS не имеет private key, не подписывает. Атакующий не создаёт подписи от имени юзеров" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t7" value="Compromise Engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d7" value="&lt;b&gt;TOTAL LOSS&lt;/b&gt; — видит public keys + JWT_SECRET → куёт токены и валидные подписи (в теории — но private key нужен от юзера)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="360" width="1020" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_t8" value="Brute-force ECDSA signature" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="p3e_d8" value="128-bit security, непрактично" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="540" y="400" width="1020" height="40" as="geometry"/></mxCell>

        <mxCell id="p3e_title2" value="&lt;b&gt;Open points (выдержка из 25 пунктов security-аудита)&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1520" height="30" as="geometry"/></mxCell>
        <mxCell id="p3e_o1" value="&lt;b&gt;Crypto / secrets&lt;/b&gt;&lt;br&gt;• TLS отсутствует в LAN — plaintext PG/Kafka/Tika/LiteLLM&lt;br&gt;• Один JWT_SECRET на webclient + engine&lt;br&gt;• Plaintext .env (engine, webclient, GitLab, LiteLLM)&lt;br&gt;• Нет secret rotation, нет vault&lt;br&gt;• LiteLLM auth = 'sk-dummy'&lt;br&gt;• Kafka без SASL/TLS — trust by VPN&lt;br&gt;• MAINTENANCE_USERS в .docker.env (bypass при утечке)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="p3e_o2" value="&lt;b&gt;Infrastructure&lt;/b&gt;&lt;br&gt;• Engine CORS = '*' (dev в prod)&lt;br&gt;• Engine без rate-limit (открыт в VPN)&lt;br&gt;• docker-vm multi-tenant — prod + n8n + сторонние&lt;br&gt;• docker.sock в gitlab-runner — побег из CI&lt;br&gt;• Kernel sharing на Proxmox LXC — CVE = всё&lt;br&gt;• Публичные SSH через NAT — брутфорс-цель&lt;br&gt;• Dual-WAN failover — ACL на обоих ISP?&lt;br&gt;• Apache Tika (Java) — CVE-prone&lt;br&gt;• NAS WriteOnce + RAID 5 — SPOF&lt;br&gt;• Dev-среда с prod-данными — нужна анонимизация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="510" width="500" height="220" as="geometry"/></mxCell>
        <mxCell id="p3e_o3" value="&lt;b&gt;Auth / data flow&lt;/b&gt;&lt;br&gt;• File upload/download без signature (legacy)&lt;br&gt;• WebSocket без signature (только JWT handshake)&lt;br&gt;• Нет admin device revoke endpoint&lt;br&gt;• Nonce-cache не persistent — replay window при рестарте&lt;br&gt;• Telegram webhook недоступен (engine за VPN)&lt;br&gt;• GitHub→GitLab миграция — план отозвать токены&lt;br&gt;• Нет signed commits/artifacts&lt;br&gt;• SSH-keys macbook — единая точка доступа к prod (HW key рекомендуется)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="510" width="480" height="220" as="geometry"/></mxCell>
        <mxCell id="p3e_obs" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;Engine: файлы /root/rugpt/logs/    ·    Webclient: docker logs (план nestjs-pino daily-dir)&lt;br&gt;PG: на postgres-vm    ·    Kafka: docker logs на docker-vm&lt;br&gt;&lt;b&gt;Sentry / Prometheus / Loki / ELK — не внедрены.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1520" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
