  <diagram id="p2c" name="2c. rugpt-container detail">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2c_title" value="&lt;b&gt;B.I.1 rugpt-container (engine)&lt;/b&gt;  ·  single Uvicorn process  ·  FastAPI :8100" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="40" as="geometry"/></mxCell>
        <mxCell id="p2c_ng" value="&lt;b&gt;nginx reverse-proxy&lt;/b&gt; (local)&lt;br&gt;/api/v1/web/* → 127.0.0.1:8100 (strip /web)&lt;br&gt;other → 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="p2c_app" value="&lt;b&gt;FastAPI :8100  (Uvicorn)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ee;strokeColor=#b85450;dashed=1;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1520" height="580" as="geometry"/></mxCell>
        <mxCell id="p2c_r" value="&lt;b&gt;Routes&lt;/b&gt;&lt;br&gt;/auth /users /roles&lt;br&gt;/chats /calendar&lt;br&gt;/notifications&lt;br&gt;/in-app-notifications&lt;br&gt;/tasks /task-polls&lt;br&gt;/task-reports&lt;br&gt;/projects (item 11)&lt;br&gt;/files /rag&lt;br&gt;/departments&lt;br&gt;/organizations /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="280" height="320" as="geometry"/></mxCell>
        <mxCell id="p2c_s" value="&lt;b&gt;Services&lt;/b&gt; — EngineService (singleton)&lt;br&gt;chat_service&lt;br&gt;ai_service (+async Kafka)&lt;br&gt;calendar_service&lt;br&gt;mention_service&lt;br&gt;notification_service&lt;br&gt;task_service + task_notification&lt;br&gt;project_service (item 11)&lt;br&gt;task_event_service&lt;br&gt;reference_service (!/!! resolve)&lt;br&gt;prompt_cache&lt;br&gt;roles_service (read-only)&lt;br&gt;users_service · org_service&lt;br&gt;scheduler_service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="320" height="320" as="geometry"/></mxCell>
        <mxCell id="p2c_a" value="&lt;b&gt;Agents&lt;/b&gt; (LangChain + LangGraph)&lt;br&gt;executor (routes by agent_type)&lt;br&gt;graphs:&lt;br&gt;  simple · chain · multi_agent&lt;br&gt;  rule_generator&lt;br&gt;&lt;br&gt;&lt;b&gt;ToolRegistry:&lt;/b&gt;&lt;br&gt;  calendar_tool (factory)&lt;br&gt;  task_tool&lt;br&gt;  rag_tool (stub)&lt;br&gt;  web_tool (stub)&lt;br&gt;  role_call_tool (stub)&lt;br&gt;&lt;br&gt;LLM: ChatOllama → LiteLLM :4000&lt;br&gt;prompts: src/engine/prompts/*.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="320" height="320" as="geometry"/></mxCell>
        <mxCell id="p2c_st" value="&lt;b&gt;Storage&lt;/b&gt; (asyncpg pool 2-10)&lt;br&gt;org · user · role&lt;br&gt;chat · message&lt;br&gt;calendar · notification_*&lt;br&gt;task · task_poll · task_report&lt;br&gt;project · task_event (item 11)&lt;br&gt;&lt;b&gt;agent_run&lt;/b&gt; — CAS idempotency (item 10)&lt;br&gt;user_file · correction_rule&lt;br&gt;user_device — ECDSA pubkeys&lt;br&gt;department · department_visibility&lt;br&gt;rag (chunks, tables_rows_chunks)&lt;br&gt;&lt;br&gt;→ PG 16 @ B.II.1 .82" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1120" y="220" width="400" height="320" as="geometry"/></mxCell>
        <mxCell id="p2c_e_rs" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p2c_r" target="p2c_s"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2c_e_sa" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p2c_s" target="p2c_a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2c_e_sst" style="endArrow=classic;html=1;strokeColor=#000000;" edge="1" parent="1" source="p2c_s" target="p2c_st"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2c_bg" value="&lt;b&gt;Background asyncio.create_task (в том же uvicorn-процессе)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1520" height="260" as="geometry"/></mxCell>
        <mxCell id="p2c_sch" value="&lt;b&gt;SchedulerService&lt;/b&gt;&lt;br&gt;polling 30s&lt;br&gt;calendar events (croniter)&lt;br&gt;per-org morning/evening task jobs&lt;br&gt;ZoneInfo per-org TZ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="820" width="340" height="180" as="geometry"/></mxCell>
        <mxCell id="p2c_kc" value="&lt;b&gt;KafkaConsumerLoop&lt;/b&gt;&lt;br&gt;topic: agent.requests&lt;br&gt;at-least-once · acks=all&lt;br&gt;&lt;br&gt;&lt;b&gt;AgentRequestHandler:&lt;/b&gt;&lt;br&gt;  CAS pending → running&lt;br&gt;  generate (AgentExecutor)&lt;br&gt;  publish chat.events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="460" y="820" width="340" height="180" as="geometry"/></mxCell>
        <mxCell id="p2c_ing" value="&lt;b&gt;IngestQueue&lt;/b&gt;&lt;br&gt;ThreadPoolExecutor · 3 воркера&lt;br&gt;отдельные asyncpg-пулы&lt;br&gt;&lt;br&gt;RAG ingestion:&lt;br&gt;  Tika → chunks → embeddings (LiteLLM) → pgvector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="820" width="340" height="180" as="geometry"/></mxCell>
