  <diagram id="p2a" name="2a. Prod-VPS internals">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2a_title" value="&lt;b&gt;A. Prod-VPS&lt;/b&gt;  ·  Ubuntu 22.04 · Docker Engine · public IP · rugpt.pro · WG peer 10.0.0.1" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="p2a_host" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1320" height="770" as="geometry"/></mxCell>
        <mxCell id="p2a_ng" value="&lt;b&gt;A.4 nginx&lt;/b&gt; (systemd)&lt;br&gt;:443 / :80&lt;br&gt;SSL Let's Encrypt (TLS 1.2/1.3)&lt;br&gt;reverse-proxy → A.1, A.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="p2a_fe" value="&lt;b&gt;A.2 webclient-frontend&lt;/b&gt;&lt;br&gt;Docker: node:20-alpine&lt;br&gt;Next.js 15 / React 19&lt;br&gt;Zustand / Tailwind&lt;br&gt;Socket.IO-client&lt;br&gt;:3000 (loopback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="p2a_be" value="&lt;b&gt;A.1 webclient-backend&lt;/b&gt;&lt;br&gt;Docker: node:20-alpine · NestJS 11 · TS&lt;br&gt;:4000 (loopback)&lt;br&gt;&lt;br&gt;&lt;b&gt;Guards:&lt;/b&gt; SignatureGuard · JwtAuthGuard · RedisWsThrottler&lt;br&gt;&lt;b&gt;Deps:&lt;/b&gt; passport-jwt · ioredis · kafkajs&lt;br&gt;bcrypt 12 · socket.io · @nestjs/throttler · axios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="360" height="200" as="geometry"/></mxCell>
        <mxCell id="p2a_rd" value="&lt;b&gt;A.3 redis&lt;/b&gt;&lt;br&gt;Docker: redis:7-alpine (AOF)&lt;br&gt;:6379 (loopback)&lt;br&gt;&lt;br&gt;Sessions · presence · outbox&lt;br&gt;rate-limit · Socket.IO adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="220" height="160" as="geometry"/></mxCell>
        <mxCell id="p2a_sio" value="&lt;b&gt;Socket.IO&lt;/b&gt;&lt;br&gt;pingInterval=10s · pingTimeout=30s&lt;br&gt;transports=['websocket']&lt;br&gt;rooms: user:&lt;id&gt; · chat:&lt;id&gt;&lt;br&gt;&lt;b&gt;WS без signature&lt;/b&gt; — JWT handshake only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="p2a_rl" value="&lt;b&gt;Rate-limit&lt;/b&gt; (Redis-backed, webclient only)&lt;br&gt;HTTP: 100/min default · 10/min strict&lt;br&gt;WS: 100/min/event/user&lt;br&gt;ключ: webchat:throttle:&lt;name&gt;:&lt;uid&gt;:&lt;route&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="p2a_cry" value="&lt;b&gt;Browser SPA crypto&lt;/b&gt;&lt;br&gt;Web Crypto API · ECDSA P-256&lt;br&gt;privateKey non-extractable (IndexedDB)&lt;br&gt;publicKey → engine user_devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="p2a_env" value="&lt;b&gt;.docker.env&lt;/b&gt;&lt;br&gt;MAINTENANCE_USERS= email:pwd,…&lt;br&gt;&lt;i&gt;(maintenance: bcrypt локально, байпас engine)&lt;/i&gt;&lt;br&gt;CORS: origin = FRONTEND_URL, credentials: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="p2a_wg" value="&lt;b&gt;WireGuard (kernel)&lt;/b&gt;&lt;br&gt;peer self = 10.0.0.1&lt;br&gt;target = 10.0.0.2 (RAG engine)&lt;br&gt;→ http://10.0.0.2/api/v1/web/*&lt;br&gt;&lt;br&gt;&lt;b&gt;App-layer auth:&lt;/b&gt; JWT + ECDSA signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="260" height="160" as="geometry"/></mxCell>
        <mxCell id="p2a_e1" value=":443 HTTPS" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2a_ng" target="p2a_ng"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="180"/><mxPoint x="40" y="180"/></Array></mxGeometry></mxCell>
        <mxCell id="p2a_e2" value="/" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p2a_ng" target="p2a_fe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2a_e3" value="/api/*" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p2a_ng" target="p2a_be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2a_e4" value=":6379" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p2a_be" target="p2a_rd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2a_e5" value="WS" style="endArrow=classic;html=1;startArrow=classic;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p2a_fe" target="p2a_be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2a_e6" value="/api/v1/web/*&#10;via WG" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;" edge="1" parent="1" source="p2a_be" target="p2a_wg"><mxGeometry relative="1" as="geometry"/></mxCell>
