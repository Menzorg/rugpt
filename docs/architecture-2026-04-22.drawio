        <mxCell id="p2b_bi2" value="&lt;b&gt;B.I.2 gitlab-container&lt;/b&gt;  .118&lt;br&gt;4 cores (53-56) · 8 GB · 150 GB · Ubuntu 24.04&lt;br&gt;&lt;br&gt;GitLab CE Omnibus&lt;br&gt;(Rails · PG · Redis · Nginx · Gitaly · Sidekiq)&lt;br&gt;SSH via NAT :28351 (workeradmin)&lt;br&gt;&lt;i&gt;миграция из GitHub после запуска&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="p2b_vm" value="&lt;b&gt;KVM Virtual Machines&lt;/b&gt; (hardware isolation)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f5e0;strokeColor=#82b366;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="1460" height="540" as="geometry"/></mxCell>
        <mxCell id="p2b_pg" value="&lt;b&gt;B.II.1 postgres-vm&lt;/b&gt;  .82&lt;br&gt;35 cores (0-34) · 368 GB · 200+2000 GB&lt;br&gt;Ubuntu 22.04&lt;br&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 16 + pgvector + pgcrypto&lt;/b&gt;&lt;br&gt;auth: scram-sha-256 / md5&lt;br&gt;pgvector: ОДНА общая схема&lt;br&gt;изоляция: org_id AND (is_public OR user_id)&lt;br&gt;vector dim 1024, HNSW&lt;br&gt;backup: pg_dump → NAS, Proxmox snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="340" height="260" as="geometry"/></mxCell>
        <mxCell id="p2b_dk" value="&lt;b&gt;B.II.2 docker-vm&lt;/b&gt;  .84&lt;br&gt;15 cores (35-49) · 70 GB · 1 TB&lt;br&gt;Ubuntu 22.04 + Docker&lt;br&gt;&lt;br&gt;&lt;b&gt;Kafka 3.7&lt;/b&gt; (bitnami KRaft) :9092&lt;br&gt;  agent.requests · chat.events&lt;br&gt;  &lt;b&gt;auth: отсутствует&lt;/b&gt; (trust by VPN)&lt;br&gt;&lt;b&gt;Apache Tika&lt;/b&gt; :9998 (no auth)&lt;br&gt;&lt;b&gt;n8n&lt;/b&gt; (план) + сторонние проекты&lt;br&gt;&lt;b&gt;multi-tenant risk!&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="460" y="440" width="340" height="260" as="geometry"/></mxCell>
        <mxCell id="p2b_rn" value="&lt;b&gt;B.II.3 gitlab-runner-vm&lt;/b&gt;  .119&lt;br&gt;4 cores (57-60) · 4 GB · 50 GB&lt;br&gt;Ubuntu 24.04 + Docker&lt;br&gt;&lt;br&gt;gitlab/gitlab-runner (Docker executor)&lt;br&gt;mount /var/run/docker.sock&lt;br&gt;concurrent=1 · SSH via NAT :24952&lt;br&gt;&lt;i&gt;рекомендация: kaniko/buildkit вместо dind&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="340" height="260" as="geometry"/></mxCell>
        <mxCell id="p2b_dv" value="&lt;b&gt;B.II.4 dev-vm&lt;/b&gt;  TBD&lt;br&gt;4 cores · 32 GB · 200 GB&lt;br&gt;Ubuntu 22.04&lt;br&gt;&lt;br&gt;&lt;b&gt;all-in-one dev copy:&lt;/b&gt;&lt;br&gt;PG + Redis + Kafka + FastAPI + NestJS + Next.js&lt;br&gt;auto-deploy: GitLab CI on push dev&lt;br&gt;Proxmox snapshot → rollback&lt;br&gt;клон prod-данных (нужна анонимизация)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="340" height="260" as="geometry"/></mxCell>
        <mxCell id="p2b_notes" value="&lt;b&gt;Внутренние потоки B.I.1 → ...&lt;/b&gt;&lt;br&gt;• → B.II.1 PG :5432 (scram, no TLS)&lt;br&gt;• → B.II.2 Kafka :9092 (no auth)&lt;br&gt;• → B.II.2 Tika :9998 (no auth)&lt;br&gt;• → C. Zver LiteLLM :4000 (Bearer sk-dummy)&lt;br&gt;• → api.telegram.org HTTPS (bot token)&lt;br&gt;• → SMTP TCP/TLS (login/pwd)&lt;br&gt;&lt;br&gt;&lt;b&gt;Резерв после dev-vm: ~0-1 core + 20 GB RAM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="740" width="1420" height="180" as="geometry"/></mxCell>
        <mxCell id="p2b_e1" value=":5432" style="endArrow=classic;html=1;strokeColor=#000000;fontSize=10;" edge="1" parent="1" source="p2b_bi1" target="p2b_pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2b_e2" value=":9092 / :9998" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p2b_bi1" target="p2b_dk"><mxGeometry relative="1" as="geometry"/></mxCell>
